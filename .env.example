# Copy to .env and `set -a; . ./.env; set +a` before `python app/backend/app.py`.
# local  = the backend runs the pipeline in-process over LOCAL folders
# databricks = the deployed App: reads the UC volumes, runs the pipeline as the bundle job
STTM_APP_MODE=local
# Where the four folders live in local mode (frds/ vdds/ reference_sttms/ output_sttms/)
STTM_LOCAL_DATA=./local_data
CATALOG=arjun_workspace
SCHEMA=sttm_agent
# databricks = Claude via this workspace's Foundation Model APIs (workspace credential,
# ~/.databrickscfg locally); anthropic = ANTHROPIC_API_KEY
STTM_PROVIDER=databricks
STTM_MODEL=claude-opus-5
STTM_JOB_NAME=frd_sttm_pipeline
STTM_JOB_ID=

# Copy to .env and fill in. .env is gitignored (.gitignore: `.env*` with a
# `!.env.example` negation), so THIS file is the only carrier that survives a
# fresh clone. Anything set only in .env is machine-local and will be lost.
#
# Local runs export it with:
#     set -a; . ./.env; set +a
# (zsh here has interactive_comments disabled -- no `#` comments inside a
# pasted shell command.)


# --------------------------------------------------------------------------- #
# Stage-2 extraction provider
# --------------------------------------------------------------------------- #
# UNSET (the default) means today's behaviour is preserved exactly:
# STTM_MOCK_EXTRACTION decides between mock replay and the Anthropic path.
# Leaving this blank changes nothing about how the pipeline has always run.
# The program is Anthropic-only as model vendor.
#
#   unset / ""   today's behaviour -- STTM_MOCK_EXTRACTION decides
#   mock         hand-authored replay specs, ZERO API calls (local only)
#   anthropic    the Anthropic API directly; needs ANTHROPIC_API_KEY
#   databricks   the SAME Claude models, served by Databricks Foundation
#                Model APIs. Needs NO Anthropic key: the workspace
#                credential authenticates (runtime identity in a job, the
#                service principal in the deployed App, ~/.databrickscfg
#                locally) and Hexaware is billed per token instead.
#                `model` is mapped automatically -- claude-opus-4-8 becomes
#                databricks-claude-opus-4-8 -- and the banner prints what it
#                resolved to. Verified against the Hexaware workspace
#                2026-08-24 including messages.stream() at max_tokens=64000.
#
# Setting this to a live provider while STTM_MOCK_EXTRACTION is also set
# RAISES rather than silently picking one -- a run that looks live but made no
# call is the failure mode this guard exists to prevent.
STTM_LLM_PROVIDER=

# Zero-cost offline replay. Ignored entirely under Databricks, by design, so a
# real workspace run can never silently skip the extraction call.
STTM_MOCK_EXTRACTION=


# --------------------------------------------------------------------------- #
# Anthropic (only read when STTM_LLM_PROVIDER is unset or "anthropic")
# --------------------------------------------------------------------------- #
# Inside Databricks this comes from the secret scope (sttm_agent/
# anthropic_api_key) and this variable is the local fallback.
#
# NOT NEEDED AT ALL with STTM_LLM_PROVIDER=databricks -- that path reads no
# key and creates no secret scope.
ANTHROPIC_API_KEY=


# --------------------------------------------------------------------------- #
# Local documents folder — the SharePoint stand-in (decided 2026-08-24, Venu)
# --------------------------------------------------------------------------- #
# Graph access did not land in time for the 2026-08-24 demo, so the FRD/STTM
# pairs sit in an ordinary folder and the app is pointed at it. When this is
# set it takes PRECEDENCE over the SharePoint block below -- a half-configured
# tenant left in this file must never silently outrank a deliberate choice.
# Unset it to go back to SharePoint; nothing else changes.
#
# The folder is FLAT (each FRD beside its STTM) and read-only to this repo.
# The same naming convention the library uses still applies, because it is
# what splits the two kinds and what pairs them:
#       FRD_<name>.docx   (also .pdf -- whatever 01 parses)
#       STTM_<name>.xlsx
# <name> MUST match across the pair -- FRD_ClaimsFeed.docx pairs with
# STTM_ClaimsFeed.xlsx by exact name. A mismatch does not fail; it falls
# through to similarity scoring and may land as "unmapped", which is the
# wrong story to tell in a demo. Files not matching either prefix are counted
# as ignored in the sync summary, never silently dropped.
#
# ~ is expanded. Example:
#   STTM_LOCAL_SOURCE_DIR=~/Desktop/frd-to-sttm-agent-documents
#
# That is the folder name on the Hexaware laptop, which is the machine
# that holds the real client FRD/STTM pairs (2026-08-24). A deployed
# Databricks App cannot read it -- it runs inside Databricks -- so to get
# those documents in front of the deployed App, run
# tools/push_local_source_to_volumes.py, which uploads them into the
# frd_raw / sttm_reference volumes (creating the volumes if needed).
STTM_LOCAL_SOURCE_DIR=


# --------------------------------------------------------------------------- #
# SharePoint / Microsoft Graph (00_sharepoint_sync, 00_sharepoint_fetch, the
# review app's "Sync now")
# --------------------------------------------------------------------------- #
# App-only client credentials against an Entra ID app registration. Required
# Graph APPLICATION permission (admin consent needed): Sites.Selected with a
# READ grant on the target site is preferred over tenant-wide Files.Read.All.
# READ is all this repo ever needs: nothing here writes to SharePoint
# (decided 2026-08-22) -- a finished STTM is uploaded by the reviewer and
# pulled back in by the sync.
#
# Inside Databricks the secret comes from the secret scope
# (sttm_agent/sharepoint_client_secret) and SHAREPOINT_CLIENT_SECRET is the
# local fallback -- same shape as ANTHROPIC_API_KEY above. Nothing here is
# defaulted in code: a half-configured tenant raises naming both remedies
# rather than failing later inside Graph with an opaque 400.
SHAREPOINT_TENANT_ID=
SHAREPOINT_CLIENT_ID=
SHAREPOINT_CLIENT_SECRET=

# Site: Graph addresses it as {host}:{server-relative path}. The path MUST
# start with '/'. Example: contoso.sharepoint.com  +  /sites/DataOffice
SHAREPOINT_HOST=
SHAREPOINT_SITE_PATH=

# Document library display name, and the folders within it. Blank folder =
# library root.
#   FRD folder        approved FRDs -> synced into the frd_raw volume
#   reference folder  approved STTM workbooks -> synced into sttm_reference;
#                     ALSO where a reviewer uploads a finished STTM (the
#                     next sync pairs it with its FRD). Blank = same folder
#                     as the FRDs (FRDs and their STTMs side by side).
# There is no output folder: this repo never writes to SharePoint.
SHAREPOINT_LIBRARY=Documents
SHAREPOINT_FRD_FOLDER=
SHAREPOINT_REFERENCE_FOLDER=

# Review app, databricks mode only: how stale the container's mirror of the
# two volumes may get (seconds) before a read re-mirrors from Unity Catalog
# -- the scheduled sync writes there without telling the app. Default 120.
STTM_CORPUS_REFRESH_SECONDS=
# Sync SharePoint -> volumes when the app starts (default on; 0 = off). With
# no tenant configured, start-up falls back to a network-free reindex.
STTM_SYNC_ON_STARTUP=
# The library's naming convention: every FRD is FRD_<name>.<ext>, every STTM
# STTM_<name>.xlsx (defaults FRD_ / STTM_; blank disables the filter).
STTM_FRD_NAME_PREFIX=
STTM_STTM_NAME_PREFIX=
# Review app, databricks mode only: the sync job's name AS DEPLOYED (a
# dev-mode bundle target prefixes it) or its numeric id. Defaults:
# frd_sttm_sharepoint_sync / unset.
STTM_SYNC_JOB_NAME=
STTM_SYNC_JOB_ID=
# Review app, databricks mode only: the render-only job used by the
# human-in-the-loop re-render (stage 04 over an existing run). Defaults:
# frd_sttm_render / unset.
STTM_RENDER_JOB_NAME=
STTM_RENDER_JOB_ID=


# --------------------------------------------------------------------------- #
# Template architecture thresholds (optional overrides; defaults live in
# src/frdsttm/similarity.py THRESHOLD_DEFAULTS and are used when unset).
# Same names work as notebook widgets in Databricks. See
# docs/TEMPLATE_ARCHITECTURE.md for what each gates. With a 2-document
# corpus and exclude-own on, TEMPLATE_SINGLE_MIN is the knob that decides
# single-template vs freeform — calibrate on the real pair before the demo.
# --------------------------------------------------------------------------- #
TEMPLATE_SINGLE_MIN=
TEMPLATE_AMALGAM_MIN=
TEMPLATE_TOP_K=
PAIR_MIN=
PAIR_HIGH=
EXCLUDE_OWN_REFERENCE=
STTM_EXEMPLARS=
STTM_EXEMPLARS_K=

# Copy to .env and fill in. .env is gitignored (.gitignore: `.env*` with a
# `!.env.example` negation), so THIS file is the only carrier that survives a
# fresh clone. Anything set only in .env is machine-local and will be lost.
#
# Local runs export it with:
#     set -a; . ./.env; set +a
# (zsh here has interactive_comments disabled -- no `#` comments inside a
# pasted shell command.)


# --------------------------------------------------------------------------- #
# Stage-2 extraction provider
# --------------------------------------------------------------------------- #
# UNSET (the default) means today's behaviour is preserved exactly:
# STTM_MOCK_EXTRACTION decides between mock replay and the Anthropic path.
# Leaving this blank changes nothing about how the pipeline has always run.
# The program is Anthropic-only as model vendor.
#
#   unset / ""   today's behaviour -- STTM_MOCK_EXTRACTION decides
#   mock         hand-authored replay specs, ZERO API calls (local only)
#   anthropic    Anthropic messages.parse, server-enforced schema
#
# Setting this to a live provider while STTM_MOCK_EXTRACTION is also set
# RAISES rather than silently picking one -- a run that looks live but made no
# call is the failure mode this guard exists to prevent.
STTM_LLM_PROVIDER=

# Zero-cost offline replay. Ignored entirely under Databricks, by design, so a
# real workspace run can never silently skip the extraction call.
STTM_MOCK_EXTRACTION=


# --------------------------------------------------------------------------- #
# Anthropic (only read when the Anthropic path is selected)
# --------------------------------------------------------------------------- #
# Inside Databricks this comes from the secret scope (sttm_agent/
# anthropic_api_key) and this variable is the local fallback.
ANTHROPIC_API_KEY=


# --------------------------------------------------------------------------- #
# SharePoint / Microsoft Graph (stages 00_sharepoint_fetch, 05_sharepoint_publish)
# --------------------------------------------------------------------------- #
# App-only client credentials against an Entra ID app registration. Required
# Graph APPLICATION permission (admin consent needed): Sites.Selected granted
# on the target site is preferred over tenant-wide Files.ReadWrite.All.
#
# Inside Databricks the secret comes from the secret scope
# (sttm_agent/sharepoint_client_secret) and SHAREPOINT_CLIENT_SECRET is the
# local fallback -- same shape as ANTHROPIC_API_KEY above. Nothing here is
# defaulted in code: a half-configured tenant raises naming both remedies
# rather than failing later inside Graph with an opaque 400.
SHAREPOINT_TENANT_ID=
SHAREPOINT_CLIENT_ID=
SHAREPOINT_CLIENT_SECRET=

# Site: Graph addresses it as {host}:{server-relative path}. The path MUST
# start with '/'. Example: contoso.sharepoint.com  +  /sites/DataOffice
SHAREPOINT_HOST=
SHAREPOINT_SITE_PATH=

# Document library display name, and the folders within it. Blank folder =
# library root. The output folder is the ONLY place this repo ever writes.
SHAREPOINT_LIBRARY=Documents
SHAREPOINT_FRD_FOLDER=
SHAREPOINT_OUTPUT_FOLDER=
